<Window x:Class="VysotskiyMI_01_03.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VysotskiyMI_01_03"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
            <Grid Margin="0,10,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="130"></RowDefinition>
                    <RowDefinition Height="130"></RowDefinition>
                    <RowDefinition Height="130"></RowDefinition>
                </Grid.RowDefinitions>

                <TextBlock Text="Введите название оператора" Grid.Row="0" Width="250" Height="20" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10,10,0,10"/>
                <TextBox x:Name="nameText" Grid.Row="0" Text="" Height="30" Width="300" HorizontalAlignment="Left" Margin="10,0,0,10"/>

                <TextBlock Text="Введите стоимость минуты разговора" Grid.Row="1" Width="250" Height="20" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10,10,0,10"/>
                <TextBox x:Name="priceText" Grid.Row="1" Width="300" Height="30" HorizontalAlignment="Left" Margin="10,0,0,10"/>

                <TextBlock Text="Введите площадь покрытия" Grid.Row="2" Width="250" Height="20" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10,10,0,10"/>
                <TextBox x:Name="ploshText" Grid.Row="2" Width="300" Height="30" HorizontalAlignment="Left" Margin="10,0,0,10"/>

                <Button Click="addBtn_Click" x:Name="addBtn" Content="Ввести" Grid.Column="0" Grid.Row="2" Width="100" Height="30" VerticalAlignment="Bottom" Margin="0,10,0,10"></Button>
            </Grid>


        </StackPanel>
        <StackPanel Grid.Column="1">
            <Grid Margin="0,10,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="130"/>
                    <RowDefinition Height="130"/>
                    <RowDefinition Height="130"/>
                </Grid.RowDefinitions>
                <CheckBox x:Name="checkPay" Content="Оплачено" Margin="10,10,10,10" Width="100" Height="30" HorizontalAlignment="Left" VerticalAlignment="Top">
                </CheckBox>
                <TextBlock x:Name="QText" Grid.Row="0" Width="300" Height="30" Margin="10" HorizontalAlignment="Left" Text="Q оператора: "/>
                <TextBlock x:Name="QpText" Grid.Row="1" Width="300" Height="30" Margin="10" HorizontalAlignment="Left" VerticalAlignment="Top" Text="Qp оператора: "/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
